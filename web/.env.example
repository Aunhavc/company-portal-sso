# =============================================================================
# Company Portal — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (ห้าม commit ไฟล์ .env)
# บน Vercel: Project Settings → Environment Variables (ใส่ทั้ง Production + Preview)
# =============================================================================

# --- Auth0 (Applications → "Company Portal - Internet" ประเภท SPA) -----------
VITE_AUTH0_DOMAIN=your-tenant.au.auth0.com
VITE_AUTH0_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Identifier ของ API ที่สร้างไว้ใน Auth0 (APIs → Create API)
# จำเป็น! ถ้าไม่ใส่ Auth0 จะคืน opaque token ซึ่ง Supabase อ่านไม่ได้
VITE_AUTH0_AUDIENCE=https://api.company.local

# บังคับให้ล็อกอินได้เฉพาะ connection นี้ (เว้นว่างได้ถ้ายังไม่ใช้ Enterprise)
# ตัวอย่าง: azure-ad, google-oauth2, Username-Password-Authentication
VITE_AUTH0_CONNECTION=

# --- Supabase (Project Settings → API) ---------------------------------------
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Portal --------------------------------------------------------------------
VITE_COMPANY_NAME=บริษัท ตัวอย่าง จำกัด
# วินาที: ระยะห่างในการ probe สถานะแอป intranet
VITE_HEALTH_POLL_SECONDS=45
# มิลลิวินาที: timeout ของแต่ละครั้งที่ probe
VITE_HEALTH_TIMEOUT_MS=2500
